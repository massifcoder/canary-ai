# PayPal Sandbox Credentials (get from developer.paypal.com)
CLIENT_ID=your_platform_client_id
CLIENT_SECRET=your_platform_client_secret
SANDBOX_API_BASE=https://api-m.sandbox.paypal.com
SANDBOX_EMAIL=sb-xxx@personal.example.com
SANDBOX_EMAIL_PASSWORD=your_sandbox_personal_password
BUSINESS_DISPLAY_APP_NAME=Canary
BUSINESS_CLIENT_ID=your_business_client_id
BUSINESS_SECRET_KEY=your_business_secret_key
SANDBOX_BUSINESS_EMAIL=sb-xxx@business.example.com
SANDBOX_BUSINESS_EMAIL_PASSWORD=your_sandbox_business_password

# Anthropic Claude API Key (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxx

# Kernel SDK API Key (get from onkernel.com)
ONKERNEL_API_KEY=sk_xxx

# Channel3 API Key (get from channel3.ai)
CHANNEL3_API_KEY=xxx
